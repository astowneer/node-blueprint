{
  "name": "acquired",
  "version": "1.0.0",
  "description": "",
  "main": "./src/server.ts",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "_prettier": "prettier \"**/*.{js,ts,tsx,json,md,css,html,yml}\" --write",
    "git:hook:precommit": "lint-staged --cwd .",
    "git:hook:commit": "npx @commitlint/cli --edit",
    "lint:editorconfig": "editorconfig-checker",
    "lint:fs": "ls-lint",
    "lint:type": "npx tsc --noEmit",
    "lint:js": "npx eslint . --fix --max-warnings=0 --no-warn-ignored",
    "lint:format": "npm run _prettier -- --check",
    "lint:trash": "knip",
    "lint": "concurrently \"npm:lint:*\" && npm run lint --workspaces",
    "build": "tsc && tsc-alias",
    "start": "nodemon --watch src --exec tsx src/server.ts",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@commitlint/types": "19.8.1",
    "@eslint/js": "9.31.0",
    "@ls-lint/ls-lint": "^2.3.1",
    "@stylistic/eslint-plugin": "^5.1.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.13",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "concurrently": "9.2.0",
    "editorconfig-checker": "6.0.1",
    "eslint": "^9.31.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.3.4",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-require-explicit-generics": "1.0.0",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "16.3.0",
    "husky": "9.1.7",
    "knip": "^5.61.3",
    "lint-staged": "16.1.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "stylelint": "16.21.1",
    "stylelint-config-recess-order": "7.1.0",
    "stylelint-config-standard": "38.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
