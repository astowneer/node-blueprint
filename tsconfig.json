{
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": "src",
    "module": "esnext",
    "noEmit": false,
    "target": "esnext",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "outDir": "./build",
    "paths": {
      "@types": ["common/types"],
      "@repositories": ["repositories"],
      "@helpers": ["helpers"],
      "@services": ["services"]
    }
  },
  "include": ["**/*.ts", "**/*.js", "prettier.config.mjs"],
  "exclude": ["node_modules", "apps", "packages"],
  "files": ["packages.d.ts"],
  "ts-node": {
    "esm": true,
    "require": ["tsconfig-paths/register"]
  }
}
